---
import { getCollection } from "astro:content";
import SiteLayout from "../layouts/SiteLayout.astro";

const notes = await getCollection("notes");
notes.sort((first, second) => second.data.date.getTime() - first.data.date.getTime());
---
<SiteLayout title="Notes - Places I want to visit">
  <h1>Notes</h1>
  <p>Ideas for getting out and exploring.</p>
  <h2>All notes</h2>
  <ul class="card-grid" role="list">
    {notes.map((note) => (
      <li class="card">
        <h3>{note.data.title}</h3>
        <p>{note.data.description}</p>
      </li>
    ))}
  </ul>
</SiteLayout>
