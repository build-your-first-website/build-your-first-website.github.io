---
import SiteLayout from "../layouts/SiteLayout.astro";
import LinkCard from "../components/LinkCard.astro";
import { Image } from "astro:assets";
import garden from "../assets/garden.jpg";

const cards = [
  {
    heading: "My visit plans",
    description: "Where I'd like to go next, and what I'd like to do there.",
    href: "/visit.html",
    linkText: "Read my visit plans"
  },
  {
    heading: "A day in York",
    description: "Walls, museums and far too many tea rooms.",
    href: "https://visityork.org/",
    linkText: "Plan a visit"
  },
  {
    heading: "About this project",
    description: "Find out why I'm building this website.",
    href: "/about.html",
    linkText: "Read about this website"
  }
];
---
<SiteLayout title="Places I want to visit">
  <h1>Places I want to visit</h1>
  <p class="introduction">Some of the places I'd like to see, and why.</p>
  <figure>
    <Image
      src={garden}
      alt="A drawing of a tree in blossom, standing on a green lawn under a blue sky."
      width={960}
      format="webp"
      loading="eager"
    />
    <figcaption>The kind of tree I'd like to sit under for an afternoon.</figcaption>
  </figure>
  <h2>Places on my list</h2>
  <p>I'm happiest somewhere with old streets, good walks and a café at the end of them.</p>
  <ul>
    <li><a href="https://visityork.org/">York</a></li>
    <li>Edinburgh</li>
    <li><a href="https://visitbath.co.uk/">Bath</a></li>
    <li>Whitby</li>
  </ul>
  <p>Find out more about <a href="https://visityork.org/">visiting York</a>.</p>
  <h2>Some ideas</h2>
  <ul class="card-grid" role="list">
    <li class="card">
      <h3>A quiet garden</h3>
      <p>Somewhere to sit and do nothing for an afternoon.</p>
    </li>
    {cards.map((card) => (
      <LinkCard
        heading={card.heading}
        description={card.description}
        href={card.href}
        linkText={card.linkText}
      />
    ))}
  </ul>
  <p class="note">A note: this website is a work in progress.</p>
</SiteLayout>
