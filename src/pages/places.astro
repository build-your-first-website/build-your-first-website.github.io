---
import SiteLayout from "../layouts/SiteLayout.astro";
---
<SiteLayout title="My wishlist - Places I want to visit">
  <h1>My wishlist</h1>
  <p>Keep a list of places you'd like to visit. It stays in your own browser.</p>
  <button id="greet" type="button">Say hello</button>
  <p id="message" role="status">Nothing has happened yet.</p>
  <script>
    import "../scripts/places.js";
  </script>
</SiteLayout>
