---
import SiteLayout from "../layouts/SiteLayout.astro";
---
<SiteLayout title="My wishlist - Places I want to visit">
  <h1>My wishlist</h1>
  <p>Keep a list of places you'd like to visit. It stays in your own browser.</p>
  <form id="place-form">
    <label for="place-name">Place name</label>
    <input id="place-name" name="place" type="text"
           aria-describedby="list-message">
    <button type="submit">Add place</button>
  </form>
  <p id="list-message" role="status"></p>
  <ul id="places"></ul>
  <button id="forget-places" type="button">Forget my list</button>
  <script>
    import "../scripts/places.js";
  </script>
</SiteLayout>
